# =============================================================================
# Copy to `.env` (git-ignored) and fill in. Nothing here belongs in the repo.
# =============================================================================

# --- Hunar Voice AI (required to place real calls) ---------------------------
# Get this from Hunar. It is read only from the environment and never logged.
HUNAR_API_KEY=
# Hunar signs webhooks with the API key itself. Only set this if your org was
# issued a separate signing secret.
HUNAR_WEBHOOK_SECRET=

# --- People search -----------------------------------------------------------
# mock | pdl | apollo | coresignal
# `mock` is a built-in deterministic dataset so the whole flow works with no
# vendor key. `proxycurl` is registered but permanently retired (see README).
PEOPLE_PROVIDER=mock
PDL_API_KEY=
APOLLO_API_KEY=
CORESIGNAL_API_KEY=

# --- LLM (optional) ----------------------------------------------------------
# With a key, job descriptions are parsed and screening questions designed by
# Claude. Without one, a deterministic parser is used instead.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- App ---------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/hireflow.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public HTTPS URL of the backend. Required for Hunar webhooks to reach you.
# Locally: `cloudflared tunnel --url http://localhost:8000` and paste the URL.
# Leave empty to fall back to polling.
PUBLIC_BASE_URL=

# --- Demo safety -------------------------------------------------------------
# When set, every outbound call is placed to THIS number instead of the
# candidate's. Use it to demo the full pipeline without calling strangers.
DEMO_CALL_REDIRECT_NUMBER=

# --- Calling defaults --------------------------------------------------------
DEFAULT_COUNTRY_CODE=IN
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_VOICE_PERSONA=NEHA
DEFAULT_LANGUAGE=ENGLISH

# --- Background reconciliation ----------------------------------------------
ENABLE_CALL_POLLER=true
CALL_POLL_INTERVAL_SECONDS=15
